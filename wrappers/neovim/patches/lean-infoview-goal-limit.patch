@@ -112,12 +112,19 @@
 ---@return Element[]? goal
 ---@return LspError? error
 function components.goal_at(sess, view_options)
-  local goal, err = goals.at(sess)
+  local goal, err, total_goals = goals.at(sess)
   if err then
     return nil, err
   end
   local children = goal and interactive_goal.Goals(goal, sess, Locations.at(sess.pos), view_options)
-  return wrap_goals(sess.pos, goal, children), err
+  local blocks = wrap_goals(sess.pos, goal, children)
+  if blocks and goal and total_goals and total_goals > #goal then
+    table.insert(blocks, 1, Element:new {
+      text = ('Showing %d of %d goals (infoview.max_goals limit).\n\n'):format(#goal, total_goals),
+      hlgroups = { 'WarningMsg' },
+    })
+  end
+  return blocks, err
 end
 
 ---@param params lsp.TextDocumentPositionParams
