--- /dev/null
+++ b/lua/lean/rpc/request.lua
@@ -0,0 +1,134 @@
+---Cancellation ownership for Lean RPC calls made by one infoview update.
+local async = require 'std.async'
+local M = {}
+local contexts = setmetatable({}, { __mode = 'k' })
+local Context = {}
+Context.__index = Context
+
+function M.new_context()
+  return setmetatable({ cancelled = false, pending = {} }, Context)
+end
+
+function Context:cancel()
+  if self.cancelled then return end
+  self.cancelled = true
+  local pending = self.pending
+  self.pending = {}
+  for cancel in pairs(pending) do cancel() end
+end
+
+function M.is_cancelled()
+  local context = contexts[coroutine.running()]
+  return context ~= nil and context.cancelled
+end
+
+function M.cancelled_error()
+  return { code = -32800, message = 'Infoview update is no longer needed' }
+end
+
+local function pack(...)
+  return { n = select('#', ...), ... }
+end
+
+---The context follows this coroutine across yields, not the cached Subsession.
+---Interactive links can therefore keep using a Subsession after its original
+---render has completed, and a second pin never inherits another pin's owner.
+function M.run(context, fn)
+  local co = assert(coroutine.running(), 'RPC context requires a coroutine')
+  local previous = contexts[co]
+  contexts[co] = context
+  local results = pack(pcall(fn))
+  contexts[co] = previous
+  if not results[1] then error(results[2], 0) end
+  return unpack(results, 2, results.n)
+end
+
+---A shared handshake survives cancellation, but its individual waiters need
+---not. Unlike async.event(), remove cancelled waiters before the event is set.
+function M.connection_event()
+  local ready, waiters = false, {}
+  return {
+    set = function()
+      ready = true
+      local pending = waiters
+      waiters = {}
+      for _, finish in pairs(pending) do finish() end
+    end,
+    wait = function()
+      local context = contexts[coroutine.running()]
+      if context and context.cancelled then return false end
+      if ready then return true end
+      return async.wrap(function(handler)
+        local completed, cancel = false, nil
+        local function finish(connected)
+          if completed then return end
+          completed = true
+          waiters[cancel] = nil
+          if context then context.pending[cancel] = nil end
+          vim.schedule(function()
+            handler(connected and not (context and context.cancelled))
+          end)
+        end
+        cancel = function() finish(false) end
+        waiters[cancel] = function() finish(true) end
+        if context then context.pending[cancel] = true end
+      end, 1)()
+    end,
+  }
+end
+
+---Await a request once, including when cancellation suppresses Neovim's callback.
+---on_late_result releases server references from a successful reply racing with
+---cancellation. It must not create widgets or cache the discarded response.
+function M.request(client, method, params, on_late_result)
+  local context = contexts[coroutine.running()]
+  if context and context.cancelled then return M.cancelled_error(), nil end
+
+  return async.wrap(function(handler)
+    local completed, response_seen = false, false
+    local request_id, cancel_request
+    local function discard(result)
+      if result ~= nil and on_late_result then on_late_result(result) end
+    end
+    local function finish(err, result)
+      if completed then return end
+      completed = true
+      if context then context.pending[cancel_request] = nil end
+      -- Scheduling also handles synchronous in-process LSP implementations:
+      -- async.wrap must yield before its handler can resume the coroutine.
+      vim.schedule(function()
+        if context and context.cancelled then
+          discard(result)
+          handler(M.cancelled_error(), nil)
+        else
+          handler(err, result)
+        end
+      end)
+    end
+    cancel_request = function()
+      if completed then return end
+      if request_id then pcall(client.cancel_request, client, request_id) end
+      -- Neovim consumes RequestCancelled ACKs without invoking the handler.
+      finish(M.cancelled_error(), nil)
+    end
+    local ok
+    ok, request_id = client:request(method, params, function(err, result)
+      if response_seen then return end
+      response_seen = true
+      if completed then
+        discard(result)
+      else
+        finish(err, result)
+      end
+    end)
+    if not ok then
+      finish({ code = -32603, message = 'Lean client could not send the request' }, nil)
+    elseif context and not completed then
+      context.pending[cancel_request] = true
+      -- Cancellation may have happened synchronously inside client:request.
+      if context.cancelled then cancel_request() end
+    end
+  end, 1)()
+end
+
+return M
