+---Release references in a successful response that arrived after its owner
+---was cancelled. Such a response never reaches register(), so no finalizer
+---proxies will release these references for us.
+function Session:release_result(result)
+  local refs = {}
+  local function collect(obj)
+    if type(obj) ~= 'table' then return end
+    for key, value in pairs(obj) do
+      if key == self.ref_key and type(value) ~= 'table' then
+        refs[#refs + 1] = { [self.ref_key] = value }
+      else
+        collect(value)
+      end
+    end
+  end
+  collect(result)
+  if #refs > 0 then self:release_deferred(refs) end
+end
